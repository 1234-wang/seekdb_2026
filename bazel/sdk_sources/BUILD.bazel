load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(":archives.bzl", "sdk_archives")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.BUILD"]) + [
    "dependencies.json",
    "prepare.py",
    "icu/embed_data.py",
    "openblas/blas_abi.h",
    "openmp/kmp_config.h",
])

cc_library(
    name = "ios_cblas",
    hdrs = ["vsag/ios/cblas.h"],
    includes = ["vsag/ios"],
    target_compatible_with = ["@platforms//os:ios"],
)

alias(
    name = "base_crypto",
    actual = select({
        "@platforms//os:emscripten": "@seekdb_3rd_wasm//:libcrypto",
        "//bazel:ios_simulator": "@seekdb_3rd_ios_simulator//:libcrypto",
        "//conditions:default": "@seekdb_3rd_ios//:libcrypto",
    }),
    target_compatible_with = select({
        "@platforms//os:ios": [],
        "@platforms//os:emscripten": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

sdk_archives(
    name = "source_sdk",
    target_compatible_with = select({
        "@platforms//os:ios": [],
        "@platforms//os:emscripten": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@seekdb_sdk_roaring//:library"] + select({
        "@platforms//os:emscripten": [
            "@seekdb_sdk_icu//:library",
            "@seekdb_sdk_s2_wasm//:library",
            "@seekdb_sdk_vsag_wasm//:library",
        ],
        "//conditions:default": [
            "@seekdb_sdk_s2_ios//:library",
            "@seekdb_sdk_vsag_ios//:library",
        ],
    }),
)

_IOS_SOURCE_REPOSITORIES = [
    "@seekdb_sdk_abseil",
    "@seekdb_sdk_antlr4",
    "@seekdb_sdk_boost",
    "@seekdb_sdk_cpuinfo",
    "@seekdb_sdk_fmt",
    "@seekdb_sdk_lapack",
    "@seekdb_sdk_nlohmann_json",
    "@seekdb_sdk_openmp",
    "@seekdb_sdk_roaring",
    "@seekdb_sdk_robin_map",
    "@seekdb_sdk_s2_ios",
    "@seekdb_sdk_spdlog",
    "@seekdb_sdk_thread_pool",
    "@seekdb_sdk_vsag_ios",
]

filegroup(
    name = "ios_source_metadata",
    srcs = [repo + "//:source_metadata" for repo in _IOS_SOURCE_REPOSITORIES],
    target_compatible_with = ["@platforms//os:ios"],
)

filegroup(
    name = "ios_licenses",
    srcs = [repo + "//:licenses" for repo in _IOS_SOURCE_REPOSITORIES],
    target_compatible_with = ["@platforms//os:ios"],
)
