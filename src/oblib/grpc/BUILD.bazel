load("//bazel:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "grpc_runtime",
    srcs = [
        "ob_grpc_context.cpp",
        "ob_grpc_server.cpp",
        "standbyservice.grpc.pb.cc",
        "standbyservice.pb.cc",
    ],
    hdrs = [
        "ob_grpc_context.h",
        "ob_grpc_server.h",
        "standbyservice.grpc.pb.h",
        "standbyservice.pb.h",
    ],
    deps = [
        "//src/oblib:oblib_base",
        "//src/oblib:oblib_foundation",
        "//bazel/third_party:absl_headers",
        "//bazel/third_party:grpc_headers",
        "//bazel/third_party:openssl_headers",
        "//bazel/third_party:protobuf_cpp_headers",
    ],
    features = ["layering_check"],
    includes = [".."],
    visibility = [
        "//src/observer:__pkg__",
        "//src/standby:__pkg__",
    ],
)
