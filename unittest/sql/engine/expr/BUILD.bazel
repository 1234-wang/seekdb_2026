load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "pl_composite_client_output_cases",
    srcs = ["test_pl_composite_client_output.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:sql_objects",
        "//src/sql:sql_runtime_internal_headers",
        "//src/pl:pl_runtime",
        "//rust:sql_nio",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_test(
    name = "test_pl_composite_client_output",
    linkstatic = True,
    deps = [":pl_composite_client_output_cases"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "pl_composite_output_pack_cases",
    srcs = ["test_pl_composite_output_pack.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:sql_objects",
        "//src/sql:sql_runtime_internal_headers",
        "//src/pl:pl_runtime",
        "//rust:sql_nio",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_test(
    name = "test_pl_composite_output_pack",
    linkstatic = True,
    deps = [":pl_composite_output_pack_cases"],
    target_compatible_with = ["@platforms//os:linux"],
)
