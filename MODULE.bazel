module(
    name = "seekdb",
    version = "0.0.0",
    bazel_compatibility = [
        ">=9.3.0",
        "<=9.3.0",
    ],
)

bazel_dep(name = "rules_cc", version = "0.2.25")
# Use public-mirror releases for the rules_cc toolchain dependencies too.
bazel_dep(name = "apple_support", version = "2.8.4")
bazel_dep(name = "platforms", version = "1.0.0")

seekdb_third_party_headers_repository = use_repo_rule(
    "//bazel:third_party_headers_repo.bzl",
    "seekdb_third_party_headers_repository",
)

seekdb_third_party_headers_repository(name = "seekdb_3rd_native")
seekdb_third_party_headers_repository(name = "seekdb_3rd_android", platform = "android")
seekdb_third_party_headers_repository(name = "seekdb_3rd_ios", platform = "iphoneos")
seekdb_third_party_headers_repository(name = "seekdb_3rd_ios_simulator", platform = "iphonesimulator")
seekdb_third_party_headers_repository(name = "seekdb_3rd_wasm", platform = "wasm")
seekdb_sdk_aliases = use_repo_rule("//bazel:third_party_headers_repo.bzl", "seekdb_sdk_aliases")
seekdb_sdk_aliases(name = "seekdb_3rd_headers")

seekdb_cc_toolchain_repository = use_repo_rule(
    "//bazel/toolchains/cc:seekdb_cc_toolchain_repo.bzl",
    "seekdb_cc_toolchain_repository",
)

seekdb_cc_toolchain_repository(name = "seekdb_cc_toolchain")

register_toolchains("@seekdb_cc_toolchain//:all")

android_cc_toolchain_repository = use_repo_rule(
    "//bazel/toolchains/cc:android_cc_toolchain_repo.bzl",
    "android_cc_toolchain_repository",
)
android_cc_toolchain_repository(name = "seekdb_android_ndk")
register_toolchains("@seekdb_android_ndk//:all")

emscripten_cc_toolchain_repository = use_repo_rule(
    "//bazel/toolchains/cc:emscripten_cc_toolchain_repo.bzl",
    "emscripten_cc_toolchain_repository",
)
emscripten_cc_toolchain_repository(name = "seekdb_emscripten")
register_toolchains("@seekdb_emscripten//:all")

# Keep the repository-owned Clang toolchain as the reproducible Linux build
# toolchain. rules_cc configures other native hosts; apple_support registers
# the macOS compiler and SDK toolchain. The Linux/glibc toolchain is not portable
# to those hosts.
cc_configure = use_extension(
    "@rules_cc//cc:extensions.bzl",
    "cc_configure_extension",
)

use_repo(
    cc_configure,
    "local_config_cc",
    "local_config_cc_toolchains",
)

register_toolchains("@local_config_cc_toolchains//:all")

# Read the same C++ export declarations used by CMake; no Cargo execution is
# needed during repository discovery or Bazel analysis.
cargo_exports_repository = use_repo_rule("//bazel:cargo.bzl", "cargo_exports_repository")
cargo_exports_repository(name = "cargo_exports", manifest = "//rust:exports.json")

local_cargo_repository = use_repo_rule("//bazel:cargo_toolchain.bzl", "local_cargo_repository")
local_cargo_repository(name = "seekdb_cargo")
register_toolchains("@seekdb_cargo//:all")

cargo_sources_repository = use_repo_rule("//bazel:cargo_toolchain.bzl", "cargo_sources_repository")
_CARGO_MANIFESTS = [
    "//rust:Cargo.toml", "//rust:config/Cargo.toml", "//rust:kv/Cargo.toml",
    "//rust:local/Cargo.toml", "//rust:sql-nio/Cargo.toml", "//rust:logger/Cargo.toml",
    "//rust:seekdb-rust/Cargo.toml", "//deps/external:Cargo.toml",
]
_CARGO_LOCKS = ["//rust:Cargo.lock", "//deps/external:Cargo.lock"]
cargo_sources_repository(name = "seekdb_cargo_native_sources", kind = "native", manifests = _CARGO_MANIFESTS, locks = _CARGO_LOCKS)
cargo_sources_repository(name = "seekdb_cargo_wasm_sources", kind = "wasm", manifests = _CARGO_MANIFESTS, locks = _CARGO_LOCKS)
