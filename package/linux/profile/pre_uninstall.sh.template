#!/bin/bash
echo "execute pre uninstall script"
cnf_file=/etc/seekdb/seekdb.cnf

systemctl stop seekdb
systemctl disable seekdb
systemctl daemon-reload

/bin/bash /usr/libexec/seekdb/scripts/telemetry.sh $1 >/dev/null 2>&1

if [ "$1" -eq 0 ] 2>/dev/null || [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -f "$cnf_file" ] && [ -s "$cnf_file" ]; then
        mkdir -p /var/lib/seekdb

        clean_script="/var/lib/seekdb/seekdb_clean.sh"
        echo "#!/bin/bash" > "$clean_script"

        # Parse the config the same way as seekdb_systemd_start: skip blank and
        # comment lines, split at the first '=', trim both sides, last value wins.
        redo_dir=""
        data_dir=""
        base_dir=""
        while IFS= read -r line; do
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

            key="${line%%=*}"
            value="${line#*=}"

            key="$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            value="$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

            case "$key" in
                "redo-dir") redo_dir="$value" ;;
                "data-dir") data_dir="$value" ;;
                "base-dir") base_dir="$value" ;;
            esac
        done < "$cnf_file"

        # Quote each path so that spaces or shell metacharacters cannot make
        # the generated script remove a different path.
        for dir in "$redo_dir" "$data_dir" "$base_dir"; do
            if [ -n "$dir" ]; then
                printf 'rm -rf -- %q\n' "$dir" >> "$clean_script"
            fi
        done

        chmod +x "$clean_script"
    fi
fi
