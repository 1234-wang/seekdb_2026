# owner: wangyunlai.wyl
# owner group: storage
# tags: allocator

SELECT COUNT(DISTINCT name) = 5 AS retired_parameters_loadable
FROM oceanbase.__all_virtual_sys_parameter_stat
WHERE name IN ('cache_wash_threshold', 'memory_chunk_cache_size',
               '_min_malloc_sample_interval', '_max_malloc_sample_interval',
               '_enable_memleak_light_backtrace');

SELECT COUNT(*) = 0 AS removed_parameters_absent
FROM oceanbase.__all_virtual_sys_parameter_stat
WHERE name IN ('local_ip', '_ctx_memory_limit', '__min_full_resource_pool_memory');

--disable_query_log
--disable_result_log
--error S42000
ALTER SYSTEM SET local_ip = '127.0.0.1';
--error S42000
ALTER SYSTEM SET _ctx_memory_limit = 'DEFAULT_CTX_ID:1G';
--error S42000
ALTER SYSTEM SET __min_full_resource_pool_memory = 1073741824;
--enable_result_log
--enable_query_log
