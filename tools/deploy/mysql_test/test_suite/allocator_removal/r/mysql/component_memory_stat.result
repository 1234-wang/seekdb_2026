SELECT COUNT(*) = 5 AS resource_rows
FROM oceanbase.__all_virtual_resource_limit;
resource_rows
1
SELECT GROUP_CONCAT(resource_name ORDER BY resource_name SEPARATOR ',') AS resources
FROM oceanbase.__all_virtual_resource_limit;
resources
kv_cache_memory,meta_object_memory,sql_workarea_memory,tablet,vector_memory
SELECT COUNT(*) = 2 AS memory_rows_with_byte_counters
FROM oceanbase.__all_virtual_resource_limit
WHERE resource_name IN ('kv_cache_memory', 'vector_memory')
AND current_utilization >= 0 AND reserved_value >= 0 AND limit_value >= 0
AND max_utilization IS NULL AND effective_limit_type = 'memory';
memory_rows_with_byte_counters
1
SELECT COUNT(*) = 1 AS tablet_semantics_preserved
FROM oceanbase.__all_virtual_resource_limit
WHERE resource_name = 'tablet' AND current_utilization > 0
AND max_utilization IS NOT NULL AND reserved_value = 0
AND effective_limit_type IN ('configuration', 'memory');
tablet_semantics_preserved
1
SELECT COUNT(*) = 6 AND SUM(resource_name = 'tablet') = 6 AS detail_only_tablet_constraints
FROM oceanbase.__all_virtual_resource_limit_detail;
detail_only_tablet_constraints
1
SELECT COUNT(*) = 6 AS tablet_constraints_preserved
FROM oceanbase.__all_virtual_resource_limit_detail
WHERE resource_name = 'tablet';
tablet_constraints_preserved
1
SELECT COUNT(*) = 4 AS repeated_memory_rows
FROM oceanbase.__all_virtual_resource_limit
WHERE max_utilization IS NULL;
repeated_memory_rows
1
SELECT COUNT(*) = 1 AS nullable_peak_schema
FROM information_schema.columns
WHERE table_schema = 'oceanbase' AND table_name = '__all_virtual_resource_limit'
  AND column_name = 'max_utilization' AND is_nullable = 'YES';
nullable_peak_schema
1
SELECT COUNT(*) = 1 AS workarea_has_profile_reports
FROM oceanbase.__all_virtual_resource_limit
WHERE resource_name = 'sql_workarea_memory'
  AND current_utilization >= 0 AND limit_value >= 0
AND reserved_value IS NULL AND max_utilization IS NULL
AND effective_limit_type = 'scheduling';
workarea_has_profile_reports
1
SELECT COUNT(*) = 1 AS detail_limit_schema_nonnullable
FROM information_schema.columns
WHERE table_schema = 'oceanbase' AND table_name = '__all_virtual_resource_limit_detail'
AND column_name = 'limit_value' AND is_nullable = 'NO';
detail_limit_schema_nonnullable
1
SELECT COUNT(*) = 1 AS nullable_reservation_schema
FROM information_schema.columns
WHERE table_schema = 'oceanbase' AND table_name = '__all_virtual_resource_limit'
  AND column_name = 'reserved_value' AND is_nullable = 'YES';
nullable_reservation_schema
1
SELECT COUNT(*) = 1 AS meta_has_usage_without_limit
FROM oceanbase.__all_virtual_resource_limit
WHERE resource_name = 'meta_object_memory' AND current_utilization > 0
AND reserved_value IS NULL AND limit_value IS NULL AND max_utilization IS NULL
AND effective_limit_type = 'none';
meta_has_usage_without_limit
1
SELECT COUNT(*) = 1 AS nullable_main_limit_schema
FROM information_schema.columns
WHERE table_schema = 'oceanbase'
  AND table_name = '__all_virtual_resource_limit'
  AND column_name = 'limit_value' AND is_nullable = 'YES';
nullable_main_limit_schema
1
SELECT COUNT(*) = 1 AS workarea_profile_observation
FROM oceanbase.__all_virtual_sql_workarea_memory_info
WHERE total_mem_used >= 0 AND workarea_hold_size IS NULL;
workarea_profile_observation
1
