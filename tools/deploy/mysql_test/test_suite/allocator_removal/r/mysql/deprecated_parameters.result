SELECT COUNT(DISTINCT name) = 6 AS retired_parameters_loadable
FROM oceanbase.__all_virtual_sys_parameter_stat
WHERE name IN ('cache_wash_threshold', 'memory_chunk_cache_size',
'__min_full_resource_pool_memory',
'_min_malloc_sample_interval', '_max_malloc_sample_interval',
'_enable_memleak_light_backtrace');
retired_parameters_loadable
1
SELECT COUNT(*) = 0 AS removed_parameters_absent
FROM oceanbase.__all_virtual_sys_parameter_stat
WHERE name IN ('local_ip', '_ctx_memory_limit');
removed_parameters_absent
1
