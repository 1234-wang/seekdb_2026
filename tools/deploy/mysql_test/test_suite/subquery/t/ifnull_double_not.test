# Issue #1477: removing an even NOT chain must preserve its result type.
--disable_query_log
SET @saved_sql_mode = @@session.sql_mode;
SET SESSION sql_mode = '';
--enable_query_log

--echo # Minimal reproducer and the two control cases.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE "x")));

--echo # Non-NULL first arguments, NULL fallback, and longer NOT chains.
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!('x' LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!('y' LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(NULL LIKE 'x')));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(!(1 LIKE 'x')))));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(!(!('x' LIKE 'x')))));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(!('y' LIKE 'x'))));
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!7));
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 < 2)));

--echo # Double negation still normalizes numeric values to booleans.
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!7)) = 1;
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(-7))) = 1;
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!0)) = 0;
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!NULL)) IS NULL;

--disable_warnings
DROP TABLE IF EXISTS ifnull_double_not;
--enable_warnings
CREATE TABLE ifnull_double_not (id INT PRIMARY KEY, value VARCHAR(8));
INSERT INTO ifnull_double_not VALUES (1, 'x'), (2, 'y'), (3, NULL), (4, '');

--echo # Row-dependent predicates retain TRUE, FALSE, and NULL behavior.
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(value LIKE 'x'))) ORDER BY id;
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT FALSE), !(!(value LIKE 'x'))) ORDER BY id;
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT TRUE), !(!(value LIKE 'x'))) ORDER BY id;
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(!(!(value LIKE 'x'))))) ORDER BY id;
SELECT id FROM ifnull_double_not
WHERE id > 0 AND IFNULL((SELECT FALSE), !(!(value LIKE 'x'))) ORDER BY id;
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(value LIKE 'x'))) OR id = 2 ORDER BY id;

--echo # Repeated prepared execution with different values and NULLs.
PREPARE stmt FROM 'SELECT id FROM ifnull_double_not WHERE IFNULL((SELECT ?), !(!(value LIKE ?))) ORDER BY id';
SET @fallback = NULL, @pattern = 'x';
EXECUTE stmt USING @fallback, @pattern;
SET @pattern = 'y';
EXECUTE stmt USING @fallback, @pattern;
SET @pattern = NULL;
EXECUTE stmt USING @fallback, @pattern;
SET @fallback = FALSE, @pattern = 'x';
EXECUTE stmt USING @fallback, @pattern;
SET @fallback = TRUE;
EXECUTE stmt USING @fallback, @pattern;
DEALLOCATE PREPARE stmt;
DROP TABLE ifnull_double_not;

--echo # Predicate simplification must retain LIKE prefix ranges, including AND/OR.
--disable_warnings
DROP TABLE IF EXISTS not_like_range;
--enable_warnings
CREATE TABLE not_like_range (v VARCHAR(32) COLLATE utf8mb4_bin PRIMARY KEY, id INT);
INSERT INTO not_like_range VALUES ('abc', 1), ('abcd', 2), ('xyz', 3);
--replace_regex /, +/,/
EXPLAIN BASIC SELECT /*+ INDEX(t PRIMARY) */ v FROM not_like_range t
WHERE v LIKE 'abc%';
--replace_regex /, +/,/
EXPLAIN BASIC SELECT /*+ INDEX(t PRIMARY) */ v FROM not_like_range t
WHERE !(!(v LIKE 'abc%'));
--replace_regex /, +/,/
EXPLAIN BASIC SELECT /*+ INDEX(t PRIMARY) */ v FROM not_like_range t
WHERE !(!(v LIKE 'abc%')) AND id > 0;
--replace_regex /, +/,/
EXPLAIN BASIC SELECT /*+ INDEX(t PRIMARY) */ v FROM not_like_range t
WHERE !(!(v LIKE 'abc%')) OR !(!(v LIKE 'xyz%'));
SELECT v FROM not_like_range WHERE !(!(v LIKE 'abc%')) ORDER BY v;
SELECT v FROM not_like_range WHERE !(!(v LIKE 'abc%')) AND id > 0 ORDER BY v;
SELECT v FROM not_like_range
WHERE !(!(v LIKE 'abc%')) OR !(!(v LIKE 'xyz%')) ORDER BY v;
DROP TABLE not_like_range;

--disable_query_log
SET SESSION sql_mode = @saved_sql_mode;
--enable_query_log
