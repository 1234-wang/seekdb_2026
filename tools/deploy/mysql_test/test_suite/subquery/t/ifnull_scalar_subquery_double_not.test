#owner: zyhmimanchi123
#owner group: subquery
# tags: subquery
#description: IFNULL with a boolean scalar subquery and a double-negated LIKE must not
#   fail with an internal error. Regression test for #1477.

--disable_warnings
--enable_warnings

# Minimal reproduction: a boolean scalar subquery as the first argument of IFNULL
# together with a double-negated LIKE in the predicate. Before the fix this
# statement failed with "ERROR 4016 (HY000): Internal error" while adding an
# implicit cast above an expression that was already an implicitly added cast.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));

# Control cases: a single negation and a plain literal both worked before the fix
# and must keep returning the same (empty) result set.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE "x")));
