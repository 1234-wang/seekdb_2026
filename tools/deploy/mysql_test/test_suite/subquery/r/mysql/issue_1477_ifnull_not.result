# Original reproducer and both control queries
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
1
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE "x")));
1
# Four NOT operators and a non-NULL true first argument
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(!(1 LIKE "x")))));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE "x")));
1
1
# A NULL first argument must use the fallback's SQL truth value
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!('abc' LIKE 'a%')));
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!('abc' LIKE 'z%')));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(NULL LIKE '%')));
1
# Boolean coercion must not return the original nonzero numeric value
SELECT IFNULL((SELECT NULL), !(!2)) AS positive,
IFNULL((SELECT NULL), !(!(-2))) AS negative,
IFNULL((SELECT NULL), !(!0)) AS zero,
IFNULL((SELECT NULL), !(!NULL)) AS unknown_value;
positive	negative	zero	unknown_value
1	1	0	NULL
# LIKE on row values, including NULL, must retain the same filtering semantics
SELECT id FROM (
SELECT 1 AS id, 'abc' AS value UNION ALL
SELECT 2, 'xyz' UNION ALL
SELECT 3, NULL
) AS rows_to_check
WHERE IFNULL((SELECT NULL), !(!(value LIKE 'a%')))
ORDER BY id;
id
1
# Preserve behavior under an explicitly typed scalar subquery
SELECT 1 FROM dual WHERE IFNULL((SELECT CAST(FALSE AS UNSIGNED)), !(!(1 LIKE "x")));
1
