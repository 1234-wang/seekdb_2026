# Minimal reproducer and the two control cases.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE "x")));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE "x"));
1
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE "x")));
1
# Non-NULL first arguments, NULL fallback, and longer NOT chains.
SELECT 1 FROM dual WHERE IFNULL((SELECT TRUE), !(!(1 LIKE 'x')));
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!('x' LIKE 'x')));
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!('y' LIKE 'x')));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(NULL LIKE 'x')));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(!(1 LIKE 'x')))));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(!(!('x' LIKE 'x')))));
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(!('y' LIKE 'x'))));
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!7));
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 < 2)));
1
# Double negation still normalizes numeric values to booleans.
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!7)) = 1;
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!(-7))) = 1;
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!0)) = 0;
1
1
SELECT 1 FROM dual WHERE IFNULL((SELECT NULL), !(!NULL)) IS NULL;
1
1
DROP TABLE IF EXISTS ifnull_double_not;
CREATE TABLE ifnull_double_not (id INT PRIMARY KEY, value VARCHAR(8));
INSERT INTO ifnull_double_not VALUES (1, 'x'), (2, 'y'), (3, NULL), (4, '');
# Row-dependent predicates retain TRUE, FALSE, and NULL behavior.
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(value LIKE 'x'))) ORDER BY id;
id
1
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT FALSE), !(!(value LIKE 'x'))) ORDER BY id;
id
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT TRUE), !(!(value LIKE 'x'))) ORDER BY id;
id
1
2
3
4
SELECT id FROM ifnull_double_not
WHERE IFNULL((SELECT NULL), !(!(!(!(value LIKE 'x'))))) ORDER BY id;
id
1
# Repeated prepared execution with different values and NULLs.
PREPARE stmt FROM 'SELECT id FROM ifnull_double_not WHERE IFNULL((SELECT ?), !(!(value LIKE ?))) ORDER BY id';
SET @fallback = NULL, @pattern = 'x';
EXECUTE stmt USING @fallback, @pattern;
id
1
SET @pattern = 'y';
EXECUTE stmt USING @fallback, @pattern;
id
2
SET @pattern = NULL;
EXECUTE stmt USING @fallback, @pattern;
id
SET @fallback = FALSE, @pattern = 'x';
EXECUTE stmt USING @fallback, @pattern;
id
SET @fallback = TRUE;
EXECUTE stmt USING @fallback, @pattern;
id
1
2
3
4
DEALLOCATE PREPARE stmt;
DROP TABLE ifnull_double_not;
