# Issue #1477: removing double negation must preserve the result type.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(1 LIKE 'x')));
1
# Controls: one negation and a literal first argument.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE 'x'));
1
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE 'x')));
1
# Non-NULL scalar subqueries keep IFNULL short-circuit semantics.
SELECT IFNULL((SELECT TRUE), !(!(1 LIKE 'x'))) AS value;
value
1
SELECT IFNULL((SELECT FALSE), !(!(1 LIKE '1'))) AS value;
value
0
# NULL scalar subqueries evaluate the double-negated fallback.
SELECT IFNULL((SELECT NULL), !(!(1 LIKE '1'))) AS value;
value
1
SELECT IFNULL((SELECT NULL), !(!(1 LIKE 'x'))) AS value;
value
0
SELECT IFNULL((SELECT NULL), !(!(NULL LIKE 'x'))) AS value;
value
NULL
# More than two negations and a double-negated first argument.
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(!(!(!(1 LIKE 'x')))));
1
SELECT IFNULL(!(!(1 LIKE '1')), (SELECT FALSE)) AS value;
value
1
SELECT IFNULL(!(!(NULL LIKE 'x')), (SELECT TRUE)) AS value;
value
1
# Row-dependent predicates must preserve types in both IFNULL arguments.
SELECT IFNULL((SELECT FALSE), !(!(c LIKE '1'))) AS value
FROM (SELECT '1' AS c UNION ALL SELECT 'x' UNION ALL SELECT NULL) AS t
ORDER BY value;
value
0
0
0
SELECT IFNULL(!(!(c LIKE '1')), (SELECT TRUE)) AS value
FROM (SELECT '1' AS c UNION ALL SELECT 'x' UNION ALL SELECT NULL) AS t
ORDER BY value;
value
0
1
1
