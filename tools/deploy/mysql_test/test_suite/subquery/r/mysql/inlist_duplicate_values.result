FROM inlist_duplicate_values WHERE (id,c) IN ((1,1),(2,2),(1,1),(2,2)) ORDER BY id;
id
1
2
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id
FROM inlist_duplicate_values WHERE c IN (-1,-1,-1,-1,9223372036854775807,9223372036854775807) ORDER BY id;
id
8
9
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id
FROM inlist_duplicate_values WHERE c IN (18446744073709551615,18446744073709551615,1,1) ORDER BY id;
id
1
# Column types are bound after this rewrite decision.
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id
FROM inlist_duplicate_values WHERE CAST(c AS CHAR) IN (1,2,3,1,2,3) ORDER BY id;
id
1
2
3
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id
FROM inlist_duplicate_values WHERE c/2 IN (1,2,3,1,2,3) ORDER BY id;
id
2
4
6
# Prepared statements cannot specialize the plan to one set of binds.
PREPARE duplicate_inlist FROM 'SELECT /*+ OPT_PARAM(''inlist_rewrite_threshold'' 4) */ COUNT(*) AS matched FROM inlist_duplicate_values WHERE c IN (?,?,?,?,?,?)';
SET @a=1, @b=2, @c=3, @d=1, @e=2, @f=3;
EXECUTE duplicate_inlist USING @a,@b,@c,@d,@e,@f;
matched
3
SET @d=4, @e=5, @f=6;
EXECUTE duplicate_inlist USING @a,@b,@c,@d,@e,@f;
matched
6
DEALLOCATE PREPARE duplicate_inlist;
DROP TABLE inlist_duplicate_values;
