# Plan reuse must preserve every independent parameter position.
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ COUNT(*) AS matched
FROM inlist_duplicate_values WHERE c IN (1,2,3,1,2,3);
matched
3
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ COUNT(*) AS matched
FROM inlist_duplicate_values WHERE c IN (1,2,3,4,5,6);
matched
6
# NULL, mixed types, row values and NOT IN preserve their semantics.
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id
FROM inlist_duplicate_values WHERE c IN (1,2,3,NULL,1,2,3,NULL) ORDER BY id;
id
