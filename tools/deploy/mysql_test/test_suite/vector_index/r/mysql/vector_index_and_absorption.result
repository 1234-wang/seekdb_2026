# Conjunct/disjunct order and unrelated required conditions do not matter.
EXPLAIN BASIC SELECT id FROM t WHERE (parity='even' OR category=1) AND id>1 AND category=1 ORDER BY l2_distance(v,'[0,0,0]') APPROXIMATE LIMIT 10;
Query Plan
==================================================
|ID|OPERATOR                               |NAME |
--------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (PRE-FILTER)|t(id)|
==================================================
Outputs & filters:
-------------------------------------
  0 - output([t.id]), filter([t.id > 1],[t.category = 1]), rowset=N
      access([t.__pk_increment],[t.category],[t.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[true,false],
      range_key([t.id],[t.shadow_pk_0]), range(1,MAX ; MAX,MAX)
SELECT id FROM t WHERE (parity='even' OR category=1) AND id>1 AND category=1 ORDER BY l2_distance(v,'[0,0,0]') APPROXIMATE LIMIT 10;
