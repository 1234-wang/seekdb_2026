# The absorbed OR and its parity column must disappear from the ANN plan.
EXPLAIN BASIC SELECT id FROM t WHERE category=1 AND (category=1 OR parity='even') ORDER BY l2_distance(v,'[0,0,0]') APPROXIMATE LIMIT 10;
Query Plan
=================================================
|ID|OPERATOR                               |NAME|
-------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (PRE-FILTER)|t   |
=================================================
Outputs & filters:
-------------------------------------
  0 - output([t.id]), filter([t.category = 1]), rowset=N
      access([t.__pk_increment],[t.category],[t.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[false],
      range_key([t.__pk_increment]), range(MIN ; MAX)always true
SELECT id FROM t WHERE category=1 AND (category=1 OR parity='even') ORDER BY l2_distance(v,'[0,0,0]') APPROXIMATE LIMIT 10;
