drop table if exists t_ann_ranges;
create table t_ann_ranges (
id int primary key,
embedding vector(3) not null,
age int,
other_age int,
key idx_age(age)
) organization heap;
insert into t_ann_ranges values
(1, '[1,0,0]', -10, 1),
(2, '[2,0,0]', 1, 20),
(3, '[3,0,0]', 5, 3),
(4, '[4,0,0]', 9, 40),
(5, '[5,0,0]', 10, 5),
(6, '[6,0,0]', 20, 60),
(7, '[7,0,0]', null, 7),
(8, '[8,0,0]', null, null),
(9, '[9,0,0]', 30, 9);
create vector index idx_vec on t_ann_ranges(embedding)
with (distance=l2, type=hnsw, lib=vsag, sync_mode=immediate);
# The filter is reduced, while the vector index and tight range remain.
explain basic select /*+ index(t idx_age) */ id from t_ann_ranges t
where age < 10 and (age < 20 and (age <= 25 and age < 30))
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
Query Plan
=======================================================
|ID|OPERATOR                               |NAME      |
-------------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (PRE-FILTER)|t(idx_age)|
=======================================================
Outputs & filters:
-------------------------------------
  0 - output([t.id]), filter([t.age < 10]), rowset=16
      access([t.__pk_increment], [t.age], [t.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[true], 
      range_key([t.age], [t.__pk_increment]), range(NULL,MAX ; 10,MIN)
select /*+ index(t idx_age) */ id from t_ann_ranges t
where age < 10 and (age < 20 and (age <= 25 and age < 30))
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
id
