# Normalize reversed operands and simplify lower bounds independently.
explain basic select /*+ index(t idx_age) */ id from t_ann_ranges t
where 20 > age and 10 > age and age >= 1 and age >= 5 and age > 5
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
Query Plan
=======================================================
|ID|OPERATOR                               |NAME      |
-------------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (PRE-FILTER)|t(idx_age)|
=======================================================
Outputs & filters:
-------------------------------------
  0 - output([t.id]), filter([10 > t.age], [t.age > 5]), rowset=16
      access([t.__pk_increment], [t.age], [t.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[true,true], 
      range_key([t.age], [t.__pk_increment]), range(5,MAX ; 10,MIN)
select /*+ index(t idx_age) */ id from t_ann_ranges t
where 20 > age and 10 > age and age >= 1 and age >= 5 and age > 5
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
id
4
# Different columns, OR branches, and contradictory bounds remain valid.
select /*+ index(t idx_age) */ id from t_ann_ranges t
where age < 10 and other_age < 10
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
id
1
3
select /*+ index(t idx_age) */ id from t_ann_ranges t
where age < 10 or age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
id
