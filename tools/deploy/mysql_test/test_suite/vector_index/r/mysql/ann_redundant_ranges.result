# Simplification must not move an outer filter below the ANN Top-K.
select id from (
select /*+ index(t idx_age) */ id, age from t_ann_ranges t
where age < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 3
) v where age >= 5 order by id;
id
3
select /*+ index(t idx_age) */ id from t_ann_ranges t
where age < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 2 offset 2;
id
3
4
drop table t_ann_ranges;
