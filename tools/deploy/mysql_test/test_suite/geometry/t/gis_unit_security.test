# Keep untrusted unit names off the stack, including diagnostic error paths.
--disable_query_log
--disable_result_log
--source mysql_test/test_suite/geometry/t/import_default_srs_data_mysql.inc
--disable_query_log
--disable_result_log
SET @long_unit = REPEAT('x', 8 * 1024 * 1024);
--error 3882
SELECT ST_DISTANCE(ST_GEOMFROMTEXT('POINT(0 0)'), ST_GEOMFROMTEXT('POINT(1 1)'), @long_unit);
--error 3902
SELECT ST_DISTANCE(ST_GEOMFROMTEXT('POINT(0 0)',4326), ST_GEOMFROMTEXT('POINT(1 1)',4326), @long_unit);
SET @long_unit = NULL;
--enable_result_log
--enable_query_log
SELECT ST_DISTANCE(ST_GEOMFROMTEXT('POINT(0 0)'), ST_GEOMFROMTEXT('POINT(3 4)')) AS distance;
SELECT 1 AS server_alive;
