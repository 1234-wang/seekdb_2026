--disable_warnings
DROP TABLE IF EXISTS access_part, access_peer, access_sub;
--enable_warnings

# Local index lookup must keep the index/base-table tablet mapping.
CREATE TABLE access_part(id INT PRIMARY KEY,k INT,payload VARCHAR(32),KEY k_idx(k) LOCAL)
PARTITION BY RANGE(id)
(PARTITION p0 VALUES LESS THAN(10),PARTITION p1 VALUES LESS THAN(20),PARTITION p2 VALUES LESS THAN MAXVALUE);
INSERT INTO access_part VALUES(1,7,'one'),(2,7,'two'),(11,7,'eleven'),(21,8,'twenty-one');
PREPARE access_lookup FROM 'SELECT /*+ INDEX(access_part k_idx) */ id,payload FROM access_part WHERE k=? ORDER BY id';
SET @k=7;
EXECUTE access_lookup USING @k;
EXECUTE access_lookup USING @k;
SET @k=8;
EXECUTE access_lookup USING @k;
SET @k=99;
EXECUTE access_lookup USING @k;

# Move a row across partitions and verify both index and base-table targets.
PREPARE access_move FROM 'UPDATE access_part SET id=? WHERE id=?';
SET @new_id=12,@old_id=2;
EXECUTE access_move USING @new_id,@old_id;
SET @new_id=22,@old_id=12;
EXECUTE access_move USING @new_id,@old_id;
SET @k=7;
EXECUTE access_lookup USING @k;
SELECT id,k,payload FROM access_part PARTITION(p0) ORDER BY id;
SELECT id,k,payload FROM access_part PARTITION(p2) ORDER BY id;

# Identically partitioned joins and reused plans must keep table references apart.
CREATE TABLE access_peer LIKE access_part;
INSERT INTO access_peer VALUES(1,17,'peer-one'),(11,17,'peer-eleven'),(21,18,'peer-twenty-one'),(22,17,'peer-twenty-two');
PREPARE access_join FROM 'SELECT /*+ PARALLEL(2) USE_HASH(b) PQ_DISTRIBUTE(b PARTITION NONE) */ a.id,a.payload,b.payload FROM access_part a JOIN access_peer b ON a.id=b.id WHERE a.id>=? ORDER BY a.id';
SET @id=0;
EXECUTE access_join USING @id;
EXECUTE access_join USING @id;
SET @id=20;
EXECUTE access_join USING @id;
SET @id=30;
EXECUTE access_join USING @id;
SELECT a.id,b.id FROM access_part a JOIN access_part b ON a.k=b.k WHERE a.id=1 ORDER BY b.id;
SELECT a.id,b.id FROM access_part a JOIN access_part b ON a.k=b.k WHERE a.id=1 ORDER BY b.id;

# Statistics collection also consumes tablet IDs for storage estimation.
--disable_result_log
ANALYZE TABLE access_part;
--enable_result_log
SELECT /*+ INDEX(access_part k_idx) */ id,payload FROM access_part WHERE k=7 ORDER BY id;

# Subpartition IDs must survive local index conversion and changing binds.
CREATE TABLE access_sub(id INT,p INT,k INT,payload VARCHAR(32),PRIMARY KEY(id,p),KEY k_idx(k) LOCAL)
PARTITION BY RANGE(id) SUBPARTITION BY HASH(p) SUBPARTITIONS 2
(PARTITION p0 VALUES LESS THAN(10),PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO access_sub VALUES(1,1,7,'a'),(1,2,7,'b'),(11,1,7,'c'),(11,2,8,'d');
PREPARE access_sub_lookup FROM 'SELECT /*+ INDEX(access_sub k_idx) */ id,p,payload FROM access_sub WHERE k=? AND id>=? ORDER BY id,p';
SET @k=7,@id=0;
EXECUTE access_sub_lookup USING @k,@id;
EXECUTE access_sub_lookup USING @k,@id;
SET @id=10;
EXECUTE access_sub_lookup USING @k,@id;
SET @k=8;
EXECUTE access_sub_lookup USING @k,@id;
SET @k=99;
EXECUTE access_sub_lookup USING @k,@id;
SELECT /*+ PARALLEL(2) */ COUNT(*),SUM(k) FROM access_sub;
SELECT /*+ PARALLEL(2) */ COUNT(*),SUM(k) FROM access_sub;

DEALLOCATE PREPARE access_sub_lookup;
DEALLOCATE PREPARE access_join;
DEALLOCATE PREPARE access_move;
DEALLOCATE PREPARE access_lookup;
DROP TABLE access_peer,access_part,access_sub;
