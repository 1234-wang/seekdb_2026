# Cached non-partitioned plans must retain per-alias and related-index targets.
--disable_warnings
DROP TABLE IF EXISTS pc_access_child, pc_access_aux, pc_access_parent, pc_access_part, pc_access_sub;
--enable_warnings
CREATE TABLE pc_access_parent(id INT PRIMARY KEY, name VARCHAR(32), payload VARCHAR(64), KEY k_name(name));
CREATE TABLE pc_access_aux(id INT PRIMARY KEY, v INT);
CREATE TABLE pc_access_child(id INT PRIMARY KEY, parent_id INT, FOREIGN KEY(parent_id) REFERENCES pc_access_parent(id));
INSERT INTO pc_access_parent VALUES(1,'alpha','one'),(2,'beta','two'),(3,'alpha','three');
INSERT INTO pc_access_aux VALUES(1,10),(2,20),(3,30);
INSERT INTO pc_access_child VALUES(1,1),(2,3);

PREPARE access_get FROM 'SELECT /*+ INDEX(pc_access_parent k_name) */ id,payload FROM pc_access_parent WHERE name=? ORDER BY id';
SET @name='alpha';
EXECUTE access_get USING @name;
EXECUTE access_get USING @name;
SET @name='beta';
EXECUTE access_get USING @name;
SET @name='absent';
EXECUTE access_get USING @name;
SET @name='alpha';
EXECUTE access_get USING @name;

SELECT a.id,b.id FROM pc_access_parent a JOIN pc_access_parent b ON a.name=b.name WHERE a.id=1 ORDER BY b.id;
SELECT a.id,b.id FROM pc_access_parent a JOIN pc_access_parent b ON a.name=b.name WHERE a.id=1 ORDER BY b.id;
SELECT p.id,p.payload,a.v FROM pc_access_parent p JOIN pc_access_aux a ON p.id=a.id WHERE p.name='alpha' ORDER BY p.id;
SELECT p.id,p.payload,a.v FROM pc_access_parent p JOIN pc_access_aux a ON p.id=a.id WHERE p.name='alpha' ORDER BY p.id;

PREPARE access_upd FROM 'UPDATE pc_access_parent SET payload=? WHERE id=?';
SET @payload='changed',@id=1;
EXECUTE access_upd USING @payload,@id;
SET @payload='updated',@id=3;
EXECUTE access_upd USING @payload,@id;
EXECUTE access_get USING @name;
PREPARE access_ins FROM 'INSERT INTO pc_access_parent VALUES(?,?,?)';
SET @id=4,@name='gamma',@payload='four';
EXECUTE access_ins USING @id,@name,@payload;
SET @id=5,@name='delta',@payload='five';
EXECUTE access_ins USING @id,@name,@payload;
--error ER_DUP_ENTRY
EXECUTE access_ins USING @id,@name,@payload;
--error ER_NO_REFERENCED_ROW_2
INSERT INTO pc_access_child VALUES(3,99);
--error ER_ROW_IS_REFERENCED_2
DELETE FROM pc_access_parent WHERE id=1;
SELECT id,name,payload FROM pc_access_parent ORDER BY id;
SELECT id,parent_id FROM pc_access_child ORDER BY id;
PREPARE access_del FROM 'DELETE FROM pc_access_parent WHERE id=?';
SET @id=4;
EXECUTE access_del USING @id;
SET @id=5;
EXECUTE access_del USING @id;
SELECT id FROM pc_access_parent ORDER BY id;
DEALLOCATE PREPARE access_del;

# A cached statement must rebind after schema invalidation.
ALTER TABLE pc_access_parent ADD COLUMN extra INT DEFAULT 7;
SET @name='alpha';
EXECUTE access_get USING @name;
EXECUTE access_get USING @name;
DEALLOCATE PREPARE access_get;
DEALLOCATE PREPARE access_upd;
DEALLOCATE PREPARE access_ins;

# Partitioned and multi-tablet plans retain their existing routing path.
CREATE TABLE pc_access_part(id INT PRIMARY KEY,v INT) PARTITION BY RANGE(id)
(PARTITION p0 VALUES LESS THAN(10),PARTITION p1 VALUES LESS THAN(20),PARTITION p2 VALUES LESS THAN MAXVALUE);
INSERT INTO pc_access_part VALUES(1,10),(11,20),(21,30);
PREPARE access_part FROM 'SELECT id,v FROM pc_access_part WHERE id=?';
SET @id=1;
EXECUTE access_part USING @id;
EXECUTE access_part USING @id;
SET @id=11;
EXECUTE access_part USING @id;
SET @id=21;
EXECUTE access_part USING @id;
SET @id=31;
EXECUTE access_part USING @id;
SELECT /*+ PARALLEL(2) */ COUNT(*),SUM(v) FROM pc_access_part;
SELECT /*+ PARALLEL(2) */ COUNT(*),SUM(v) FROM pc_access_part;
SELECT id,v FROM pc_access_part PARTITION(p1) ORDER BY id;
DEALLOCATE PREPARE access_part;

CREATE TABLE pc_access_sub(id INT,p INT,v INT,PRIMARY KEY(id,p))
PARTITION BY RANGE(id) SUBPARTITION BY HASH(p) SUBPARTITIONS 2
(PARTITION p0 VALUES LESS THAN(10),PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO pc_access_sub VALUES(1,1,10),(1,2,20),(11,1,30);
PREPARE access_sub FROM 'SELECT v FROM pc_access_sub WHERE id=? AND p=?';
SET @id=1,@p=1;
EXECUTE access_sub USING @id,@p;
EXECUTE access_sub USING @id,@p;
SET @id=11;
EXECUTE access_sub USING @id,@p;
SET @p=2;
EXECUTE access_sub USING @id,@p;
DEALLOCATE PREPARE access_sub;
DROP TABLE pc_access_child,pc_access_aux,pc_access_parent,pc_access_part,pc_access_sub;
