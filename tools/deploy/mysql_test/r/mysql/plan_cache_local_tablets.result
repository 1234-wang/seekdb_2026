DROP TABLE IF EXISTS pc_loc_child, pc_loc_aux, pc_loc_parent, pc_loc_part, pc_loc_sub;
CREATE TABLE pc_loc_parent(id INT PRIMARY KEY, name VARCHAR(32), payload VARCHAR(64), KEY k_name(name));
CREATE TABLE pc_loc_aux(id INT PRIMARY KEY, v INT);
CREATE TABLE pc_loc_child(id INT PRIMARY KEY, parent_id INT, FOREIGN KEY(parent_id) REFERENCES pc_loc_parent(id));
INSERT INTO pc_loc_parent VALUES(1,'alpha','one'),(2,'beta','two'),(3,'alpha','three');
INSERT INTO pc_loc_aux VALUES(1,10),(2,20),(3,30);
INSERT INTO pc_loc_child VALUES(1,1),(2,3);
PREPARE loc_get FROM 'SELECT /*+ INDEX(pc_loc_parent k_name) */ id,payload FROM pc_loc_parent WHERE name=? ORDER BY id';
SET @name='alpha';
EXECUTE loc_get USING @name;
id	payload
1	one
3	three
EXECUTE loc_get USING @name;
id	payload
1	one
3	three
SET @name='beta';
EXECUTE loc_get USING @name;
id	payload
2	two
SET @name='absent';
EXECUTE loc_get USING @name;
id	payload
SET @name='alpha';
EXECUTE loc_get USING @name;
id	payload
1	one
3	three
SELECT a.id,b.id FROM pc_loc_parent a JOIN pc_loc_parent b ON a.name=b.name WHERE a.id=1 ORDER BY b.id;
id	id
1	1
1	3
SELECT a.id,b.id FROM pc_loc_parent a JOIN pc_loc_parent b ON a.name=b.name WHERE a.id=1 ORDER BY b.id;
id	id
1	1
1	3
SELECT p.id,p.payload,a.v FROM pc_loc_parent p JOIN pc_loc_aux a ON p.id=a.id WHERE p.name='alpha' ORDER BY p.id;
id	payload	v
1	one	10
3	three	30
SELECT p.id,p.payload,a.v FROM pc_loc_parent p JOIN pc_loc_aux a ON p.id=a.id WHERE p.name='alpha' ORDER BY p.id;
id	payload	v
1	one	10
3	three	30
PREPARE loc_upd FROM 'UPDATE pc_loc_parent SET payload=? WHERE id=?';
SET @payload='changed',@id=1;
EXECUTE loc_upd USING @payload,@id;
SET @payload='updated',@id=3;
EXECUTE loc_upd USING @payload,@id;
EXECUTE loc_get USING @name;
id	payload
1	changed
3	updated
PREPARE loc_ins FROM 'INSERT INTO pc_loc_parent VALUES(?,?,?)';
SET @id=4,@name='gamma',@payload='four';
EXECUTE loc_ins USING @id,@name,@payload;
SET @id=5,@name='delta',@payload='five';
EXECUTE loc_ins USING @id,@name,@payload;
EXECUTE loc_ins USING @id,@name,@payload;
