DEALLOCATE PREPARE loc_upd;
DEALLOCATE PREPARE loc_ins;
CREATE TABLE pc_loc_part(id INT PRIMARY KEY,v INT) PARTITION BY RANGE(id)
(PARTITION p0 VALUES LESS THAN(10),PARTITION p1 VALUES LESS THAN(20),PARTITION p2 VALUES LESS THAN MAXVALUE);
INSERT INTO pc_loc_part VALUES(1,10),(11,20),(21,30);
PREPARE loc_part FROM 'SELECT id,v FROM pc_loc_part WHERE id=?';
SET @id=1;
EXECUTE loc_part USING @id;
id	v
1	10
EXECUTE loc_part USING @id;
id	v
1	10
SET @id=11;
EXECUTE loc_part USING @id;
id	v
11	20
SET @id=21;
EXECUTE loc_part USING @id;
id	v
21	30
SET @id=31;
EXECUTE loc_part USING @id;
id	v
SELECT /*+ PARALLEL(2) */ COUNT(*),SUM(v) FROM pc_loc_part;
COUNT(*)	SUM(v)
3	60
SELECT /*+ PARALLEL(2) */ COUNT(*),SUM(v) FROM pc_loc_part;
COUNT(*)	SUM(v)
3	60
SELECT id,v FROM pc_loc_part PARTITION(p1) ORDER BY id;
id	v
11	20
DEALLOCATE PREPARE loc_part;
CREATE TABLE pc_loc_sub(id INT,p INT,v INT,PRIMARY KEY(id,p))
PARTITION BY RANGE(id) SUBPARTITION BY HASH(p) SUBPARTITIONS 2
(PARTITION p0 VALUES LESS THAN(10),PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO pc_loc_sub VALUES(1,1,10),(1,2,20),(11,1,30);
PREPARE loc_sub FROM 'SELECT v FROM pc_loc_sub WHERE id=? AND p=?';
SET @id=1,@p=1;
EXECUTE loc_sub USING @id,@p;
v
10
EXECUTE loc_sub USING @id,@p;
v
10
SET @id=11;
EXECUTE loc_sub USING @id,@p;
v
30
SET @p=2;
EXECUTE loc_sub USING @id,@p;
v
DEALLOCATE PREPARE loc_sub;
DROP TABLE pc_loc_child,pc_loc_aux,pc_loc_parent,pc_loc_part,pc_loc_sub;
