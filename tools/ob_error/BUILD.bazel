load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "error_parser",
    srcs = ["src/ob_error.cpp", "src/os_errno.cpp"],
    hdrs = ["src/ob_error.h", "src/os_errno.h"],
    copts = ["-std=c++20"],
    linkstatic = True,
    deps = ["//src/share:error_code_parser"],
)

cc_binary(
    name = "ob_error",
    srcs = ["src/main.cpp"],
    deps = [":error_parser"],
)

cc_shared_library(
    name = "oberror",
    deps = [":error_parser"],
)

cc_test(
    name = "test_ob_error",
    linkstatic = True,
    srcs = ["test/test_ob_error.cpp"],
    deps = [":error_parser", "@seekdb_3rd_headers//:gtest"],
)
